# freeflow-omniroute environment example
# Copy to .env and adjust for your deployment

# ── Server ───────────────────────────────────────────────────────
FREEFLOW_PORT=28280
FREEFLOW_HOST=0.0.0.0

# ── Auth ─────────────────────────────────────────────────────────
# Set a token to require authentication on all /v1/* routes
# FREEFLOW_API_TOKEN=your-secret-token-here
# FREEFLOW_REQUIRE_AUTH=true

# ── Relays (optional) ───────────────────────────────────────────
# Comma-separated list of relay URLs for OpenCode Zen rate-limit avoidance
# FREEFLOW_RELAYS=https://relay1.workers.dev,https://relay2.deno.dev
# FREEFLOW_RELAY_MODE=auto

# ── Debug ────────────────────────────────────────────────────────
# FREEFLOW_DEBUG=1

# ── Data directory ───────────────────────────────────────────────
# FREEFLOW_DATA_DIR=/opt/freeflow-omniroute/data
